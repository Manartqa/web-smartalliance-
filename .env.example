# Template only — NEVER put real credentials in this file. It is the one env
# file that IS committed. Copy it to .env.local (gitignored) and fill that in:
#
#   cp .env.example .env.local
#
# Next.js does NOT read .env.example. Only .env.local / .env / .env.development
# are loaded, so values left here have no effect on the running app.
#
# QUOTE any value containing '#'. Unquoted values starting with '#' parse as an
# empty string, and a '#' after a space starts a comment.

# --- Contact form: mail server -------------------------------------------
SMTP_HOST=smtp.office365.com
# 587 = STARTTLS (usual), 465 = implicit TLS
SMTP_PORT=587
# Optional. Defaults to true only when SMTP_PORT is 465.
# SMTP_SECURE=false
# The mailbox the site sends as.
SMTP_USER=someone@example.co.th

# --- Auth: OAuth2 (required on Microsoft 365) ----------------------------
# smartalliance.co.th runs on Exchange Online with Security Defaults enabled,
# which blocks Basic Authentication — a password login is refused with
# "535 5.7.139 ... locked by your organization's security defaults policy".
#
# Use an Entra ID App Registration instead. Default transport is Microsoft
# Graph, which needs the *application* permission Mail.Send with admin consent.
# (Forcing MAIL_TRANSPORT=smtp instead needs SMTP.SendAsApp — a different
# permission, plus an Exchange service principal and a mailbox grant.)
MS_TENANT_ID=
MS_CLIENT_ID=
# The secret VALUE, not the secret ID. Rotate it when it expires.
MS_CLIENT_SECRET=
# ...or supply it encrypted instead, and keep CONFIG_MASTER_KEY somewhere else
# entirely (host secret store / systemd unit / shell profile — NOT this file,
# and NOT .env.local, or the encryption buys you nothing).
#   npm run secret:genkey
#   npm run secret:encrypt
# MS_CLIENT_SECRET_ENC=enc:v1:...

# --- Auth: password (only for servers that still allow Basic Auth) -------
# Leave the MS_* block empty to use this instead.
# SMTP_PASSWORD="your-password-here"

# --- Delivery ------------------------------------------------------------
# Where enquiries are delivered. Comma-separated for several recipients.
CONTACT_MAIL_TO=someone@example.co.th
# Envelope sender. Defaults to SMTP_USER — Exchange rejects anything else.
# CONTACT_MAIL_FROM="Smart Alliance Website <someone@example.co.th>"

# --- Site ----------------------------------------------------------------
# Absolute URL used for canonical links and Open Graph.
# NEXT_PUBLIC_SITE_URL=https://www.smartalliance.co.th

# --- Rate limiting --------------------------------------------------------
# Set to 1 ONLY when a reverse proxy in front of this app overwrites
# `X-Forwarded-For` (nginx with `proxy_set_header`, Cloudflare, a cloud load
# balancer). It makes the contact form's limit per client IP.
#
# Left unset, that header is ignored — anyone can forge it, and a forged value
# per request means a limiter that never limits — and every submission shares
# one budget instead. The hourly site-wide ceiling in the route applies either
# way.
# TRUST_PROXY=1

# --- Search engine verification ------------------------------------------
# Both are read at build time and rendered as <meta> in every page's <head>.
# Leave them unset and no tag is emitted at all — an empty verification tag is
# worse than none, because the console reads it as a failed check.
#
# Google Search Console → Settings → Ownership verification → HTML tag.
# Paste ONLY the content value, not the whole <meta> element.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Site → Verify → Option 1 (meta tag), `content` value.
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
