# Keeps the build context small and, more importantly, keeps secrets out of it.
# Everything here is either rebuilt inside the image or must never reach it.

node_modules
.next
out
build
deploy
coverage

# Secrets. `.env.example` is the one env file that is committed and carries no
# real values; every other .env* is either local or production configuration and
# has no business inside an image layer.
.env
.env.*
!.env.example

.git
.gitignore
.github

# Not needed to build or run the site.
tests
vitest.config.mts
*.md
!README.md
scripts
.claude
.vscode
.idea

Dockerfile
.dockerignore
compose.yaml
docker-compose.yml

npm-debug.log*
*.tsbuildinfo
.DS_Store
